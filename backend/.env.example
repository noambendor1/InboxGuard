# Copy this file to .env for local development.
# Never commit the real .env file.

# Port the Express server listens on locally (Cloud Run supplies its own PORT)
PORT=8080

# Shared secret used to verify HMAC-SHA256 signed requests from the Gmail Add-on.
# Must match the "sharedSecret" Script Property configured in the Apps Script project.
# Generate a strong random value, e.g.: openssl rand -hex 32
INBOXGUARD_SHARED_SECRET=replace-with-a-long-random-secret

# Google Safe Browsing API key (server-side only, never sent to the Add-on).
# See docs/DEPLOYMENT.md for how to create this key.
SAFE_BROWSING_API_KEY=replace-with-your-safe-browsing-api-key

# Optional: comma-separated list of origins allowed to call this API.
# The Gmail Add-on calls the backend server-to-server, so this is mostly a safety net.
ALLOWED_ORIGIN=

# Optional: how many seconds a signed request stays valid for (replay window).
MAX_REQUEST_AGE_SECONDS=300
